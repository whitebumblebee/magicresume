# ---- Genkit + Vertex AI ----
# Local development uses Application Default Credentials:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.7-flash
# Optional Vertex express-mode alternative to ADC:
# VERTEX_API_KEY=

# Firestore sessions automatically use GOOGLE_CLOUD_PROJECT. For local emulation:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ---- Auth.js (M4) ----
# openssl rand -base64 32
AUTH_SECRET=
# Google OAuth (optional in dev — a dev-only email login appears without it)
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Production canonical URL. Auth.js trusts Cloud Run's forwarded host when set.
# AUTH_URL=https://your-cloud-run-host
# AUTH_TRUST_HOST=true

# ---- Database (M4) ----
# Local dev: leave unset → embedded PGlite at .pglite/ (zero setup).
# Production: pooled Neon Postgres URL with TLS required.
# Keep this value in Secret Manager as mr-database-url; never commit it.
# DATABASE_URL=postgresql://user:pass@host/mr?sslmode=require

# Cloud Run enables Google Cloud Genkit telemetry automatically.
# Set only for local telemetry testing:
# GENKIT_TELEMETRY_FORCE=1
